# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_DATABASE_SUPABASE_URL=your-database-url
NEXT_PUBLISHABLE_SUPABASE_KEY=your-publishable-key

# AI Provider (groq | google | anthropic | openai)
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRO_PRICE_ID=price_...

# Resend
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Cached <schedule@yourdomain.com>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

#OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_APP_CLIENT_SECRET=your-github
